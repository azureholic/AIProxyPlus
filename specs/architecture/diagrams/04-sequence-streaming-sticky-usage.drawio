    <!-- Messages -->
    <mxCell id="m1" value="POST .../responses {model, stream:true, previous_response_id:&quot;resp_abc&quot;}" style="html=1;endArrow=block;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="110" as="sourcePoint" /><mxPoint x="280" y="110" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="m2" value="Authenticate consumer (API key hash), resolve deployment + previous_response_id &quot;resp_abc&quot;" style="html=1;endArrow=block;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="150" as="sourcePoint" /><mxPoint x="460" y="150" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="m3" value="Lookup existing endpoint for response id &quot;resp_abc&quot; (automatic, no config flag)" style="html=1;endArrow=block;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="190" as="sourcePoint" /><mxPoint x="640" y="190" as="targetPoint" /></mxGeometry></mxCell>

    <mxCell id="alt1" value="alt: previous_response_id known and healthy -&gt; Affinity returns Endpoint E (sticky)&#10;else: Router selects by priority + round-robin and stores (response_id, deployment, endpoint) in Affinity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="390" y="220" width="330" height="60" as="geometry" /></mxCell>

