    <mxCell id="m6" value="SSE chunk 1..n (passthrough)" style="html=1;endArrow=open;dashed=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="390" as="sourcePoint" /><mxPoint x="100" y="390" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="m7" value="response.completed event (with usage + new response id)" style="html=1;endArrow=open;dashed=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="430" as="sourcePoint" /><mxPoint x="460" y="430" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="m8" value="Write UsageRecord + persist (new response id -&gt; Endpoint E) in Affinity" style="html=1;endArrow=block;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="470" as="sourcePoint" /><mxPoint x="1000" y="470" as="targetPoint" /></mxGeometry></mxCell>

    <mxCell id="alt2" value="alt: client requested include_usage -&gt; forward usage chunk to client&#10;else: client did not request it -&gt; suppress usage-only chunk (transparent proxy)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="130" y="510" width="330" height="60" as="geometry" /></mxCell>

