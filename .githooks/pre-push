#!/bin/sh
# Blocks a push when gitleaks finds a secret in any commit about to be pushed.
# Enable once per clone: git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed; install it (winget install Gitleaks.Gitleaks) or see docs/security-scanning.md." >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
remote_name="${1:-origin}"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: pushing to main is not allowed. Push a branch and open a pull request." >&2
    exit 1
  fi

  # gitleaks exits 0 when git rejects the range, so validate input and fail closed.
  case "$local_sha$remote_sha" in
    *[!0-9a-f]*) echo "pre-push: unexpected ref input; refusing to push without a scan." >&2; exit 1 ;;
  esac

  if [ "$remote_sha" = "$zero" ]; then
    # Exclude only what the destination already has, not commits reachable from any other remote.
    range="$local_sha --not --remotes=$remote_name"
  else
    # A force-push over an unfetched remote tip has no valid range; refuse instead of skipping the scan.
    if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      echo "pre-push: remote tip $remote_sha is not available locally; run 'git fetch $remote_name' and retry." >&2
      exit 1
    fi
    range="$remote_sha..$local_sha"
  fi

  # shellcheck disable=SC2086
  gitleaks git --config .gitleaks.toml --redact --no-banner --log-opts="$range" . || status=1
  # shellcheck disable=SC2086
  gitleaks git --config .gitleaks.lockfiles.toml --redact --no-banner --log-opts="$range" . || status=1
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: potential secret detected. Remove it, rotate the credential, and rewrite the commit before pushing." >&2
fi

exit "$status"
