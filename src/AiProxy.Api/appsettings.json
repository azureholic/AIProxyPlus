{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Workload": {
      "Oidc": {
        "Enabled": false,
        "Authority": "https://identity.example.com",
        "Audience": "api://ai-proxy",
        "RequiredScope": "aiproxy.invoke",
        "AllowedSigningAlgorithms": ["RS256", "PS256", "ES256"]
      },
      "ManagedIdentity": {
        "Enabled": false,
        "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
        "Audience": "api://ai-proxy",
        "RequiredRole": "AiProxy.Invoke",
        "AllowedSigningAlgorithms": ["RS256"]
      }
    }
  }
}
