using './api-containerapp.module.bicep'

param api_containerimage = '{{ .Image }}'
param api_identity_client_id_value = '{{ .Env.API_IDENTITY_CLIENTID }}'
param api_identity_outputs_clientid = '{{ .Env.API_IDENTITY_CLIENTID }}'
param api_identity_outputs_id = '{{ .Env.API_IDENTITY_ID }}'
param applicationinsights_connection_string_value = '{{ .Env.APPLICATIONINSIGHTS_CONNECTION_STRING }}'
param entra_authority_value = '{{ .Env.AZURE_ENTRA_AUTHORITY }}'
param entra_client_id_value = '{{ .Env.AZURE_ENTRA_CLIENT_ID }}'
param environment_outputs_azure_container_apps_environment_default_domain = '{{ .Env.ENVIRONMENT_AZURE_CONTAINER_APPS_ENVIRONMENT_DEFAULT_DOMAIN }}'
param environment_outputs_azure_container_apps_environment_id = '{{ .Env.ENVIRONMENT_AZURE_CONTAINER_APPS_ENVIRONMENT_ID }}'
param environment_outputs_azure_container_registry_endpoint = '{{ .Env.ENVIRONMENT_AZURE_CONTAINER_REGISTRY_ENDPOINT }}'
param environment_outputs_azure_container_registry_managed_identity_id = '{{ .Env.ENVIRONMENT_AZURE_CONTAINER_REGISTRY_MANAGED_IDENTITY_ID }}'
param keyvault_outputs_name = '{{ .Env.KEYVAULT_NAME }}'
param keyvault_outputs_vaulturi = '{{ .Env.KEYVAULT_VAULTURI }}'
param postgres_kv_outputs_name = '{{ .Env.POSTGRES_KV_NAME }}'
param postgres_outputs_hostname = '{{ .Env.POSTGRES_HOSTNAME }}'
param postgres_password_value = '{{ securedParameter "postgres_password" }}'
param postgres_username_value = '{{ parameter "postgres_username" }}'
