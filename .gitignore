# Build artifacts
[Bb]in/
[Oo]bj/
*.user

# Rider / VS
.vs/
.idea/
*.suo

# Runtime debug logs (Serilog rolling file sink) — keep the folder, ignore contents
logs/*
!logs/.gitkeep
# Serilog writes relative to the process's content root, which varies by how the Api is launched
src/AiProxy.Api/logs/

# dotnet test TRX/coverage output — keep the folder, ignore contents
test-results/*
!test-results/.gitkeep

# Frontend build output (Vite writes straight into wwwroot — a build artifact, not source)
src/AiProxy.Api/wwwroot/*
!src/AiProxy.Api/wwwroot/.gitkeep
